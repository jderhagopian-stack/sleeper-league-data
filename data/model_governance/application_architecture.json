{
  "model_version": "FSFFL-Application-Architecture-1.0",
  "principles": {
    "shared_core_owns_reusable_concepts": true,
    "applications_own_application_specific_reasoning": true,
    "canonical_within_application_does_not_imply_shared": true,
    "promotion_to_shared_requires_domain_generic_behavior_or_real_second_application_consumer": true,
    "migration_scaffolding_is_not_permanent_platform_api": true,
    "historical_versions_may_remain_for_reproducibility_but_not_current_authority": true
  },
  "shared_core": {
    "projection_and_uncertainty": [
      "script/build_fsffl_player_projections.py",
      "script/build_fsffl_weekly_projections.py"
    ],
    "simulation": [
      "script/build_fsffl_season_simulator.py",
      "script/run_fsffl_season_simulator_preproduction.py"
    ],
    "lineup_optimization": [
      "script/lineup_optimizer.py"
    ],
    "behavioral_intelligence": [
      "script/behavioral_intelligence.py",
      "script/behavioral_intelligence_v3.py",
      "script/behavioral_intelligence_v3_production.py"
    ],
    "historical_fact_reconstruction": [
      "script/fsffl_historical_state_provider.py"
    ],
    "roster_interaction_primitive": [
      "script/roster_interaction.py"
    ],
    "league_rules": [
      "script/league_rules.py"
    ]
  },
  "applications": {
    "trade_decision": {
      "entrypoint": "script/trade_engine.py",
      "internal_reasoning": [
        "script/trade_option_governance.py",
        "script/trade_candidate_pools.py",
        "script/trade_candidate_selector.py",
        "script/trade_state_policy.py",
        "script/trade_bilateral_gate.py",
        "script/trade_negotiation_family.py",
        "script/trade_multi_asset_packages.py",
        "script/negotiation_ranking.py",
        "script/roster_interaction_overlay.py",
        "script/roster_resolution_governance.py",
        "script/trade_decision/behavior_integration.py",
        "script/trade_decision/historical_behavior_policy.py"
      ],
      "migration_scaffolding": [
        "script/trade_state_selector_composition.py",
        "script/trade_multi_asset_composition.py",
        "script/trade_bilateral_composition.py"
      ]
    },
    "gm3": {
      "entrypoint": "script/run_fsffl_gm30_counterfactual_governed.py",
      "internal_reasoning": [
        "script/gm3/application.py",
        "script/build_fsffl_gm30.py",
        "script/run_fsffl_gm30_counterfactual.py",
        "script/gm30_nonprojection_governance.py",
        "script/package_curve_robustness.py",
        "script/nonprojection_high_priority_overrides.py"
      ],
      "application_boundary": "script/gm3/application.py",
      "legacy_mechanics_provider": "script/build_fsffl_gm_engine.py",
      "legacy_provider_current_application_authority": false
    },
    "team_improvement": {
      "entrypoint": "script/run_team_improvement_lab.py",
      "ownership": "GM3 application family"
    },
    "historical_trade_analysis": {
      "entrypoint": "script/run_historical_trade_analysis.py",
      "ownership": "application using shared historical facts plus GM3/Decision Lab"
    },
    "draft_intelligence": {
      "entrypoint": "script/draft_intelligence/application.py",
      "internal_reasoning": [
        "script/build_gm30_prospect_inputs.py",
        "script/build_gm30_prospect_features.py",
        "script/build_gm30_prospect_engine.py"
      ],
      "gm3_consumes_output": true,
      "gm3_owns_model": false
    },
    "contender_analysis": {
      "current_implementation": "Simulator outputs plus league power presentation",
      "entrypoint": "script/render_league_power_report.py"
    },
    "portfolio_asset_management": {
      "current_implementation": "GM3 emerging-value / franchise outputs",
      "entrypoint": "script/build_gm30_emerging_value.py"
    },
    "breakout_sleeper_intelligence": {
      "entrypoint": "script/breakout_intelligence/application.py",
      "internal_reasoning": [
        "script/build_gm30_emerging_value.py"
      ],
      "gm3_consumes_output": true,
      "gm3_owns_model": false,
      "rookies_owned_by": "Draft Intelligence"
    },
    "what_if_alternate_history": {
      "application_family": "Counterfactual",
      "modes": {
        "forward_what_if": {
          "current_implementation": "script/run_fsffl_gm30_counterfactual.py",
          "current_owner": "GM3 application integration",
          "future_boundary": "Counterfactual application family"
        },
        "historical_alternate_history": {
          "shared_foundation": "script/fsffl_historical_state_provider.py",
          "current_main_status": "shared historical reconstruction present; full Alternate History application is not yet current production on main",
          "historical_trade_consumer": "script/run_historical_trade_analysis.py"
        }
      },
      "shared_primitives": [
        "historical state reconstruction",
        "state cloning and transaction application",
        "roster legality",
        "simulation",
        "branch/state transition mechanics"
      ]
    }
  },
  "analytics_derived_products": {
    "record_book": {
      "builder": "script/build_competition_record_book.py",
      "audit_builder": "script/build_record_book_audit.py",
      "source_role": "deterministic historical aggregation",
      "predictive_model": false
    },
    "competitive_landscape": {
      "source": "Simulator application outputs",
      "renderer": "script/render_league_power_report.py",
      "independent_power_model": false
    },
    "historical_trade_analysis": {
      "entrypoint": "script/run_historical_trade_analysis.py",
      "role": "historical reconstruction plus existing GM3/Decision Lab evaluation",
      "independent_valuation_model": false
    }
  },
  "reports_publications": {
    "standardized_report_pack": {
      "workflow": ".github/workflows/build-standardized-reports.yml",
      "presentation_only": true
    },
    "record_book": {
      "renderer": "script/render_record_book_report.py",
      "consumes": "analytics_derived_products.record_book"
    },
    "competitive_landscape": {
      "renderer": "script/render_league_power_report.py",
      "consumes": "Simulator outputs"
    },
    "draft_recap": {
      "renderer": "script/render_draft_recap_report.py",
      "consumes": [
        "Draft Intelligence",
        "GM3/team state"
      ]
    },
    "team_season_outlook": {
      "renderer": "script/render_simulator_report.py",
      "consumes": "Simulator outputs"
    },
    "gm_franchise_report": {
      "renderer": "script/render_gm_franchise_report.py",
      "consumes": "GM3 outputs"
    },
    "preseason_report": {
      "status": "publication/orchestration product",
      "consumes": [
        "Simulator",
        "GM3",
        "Draft Intelligence",
        "Breakout/Sleeper Intelligence",
        "Shared Core valuation/team state"
      ],
      "owns_independent_model": false
    }
  }
}
