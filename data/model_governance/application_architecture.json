{
  "model_version": "FSFFL-Application-Architecture-1.0",
  "principles": {
    "shared_core_owns_reusable_concepts": true,
    "applications_own_application_specific_reasoning": true,
    "canonical_within_application_does_not_imply_shared": true,
    "promotion_to_shared_requires_domain_generic_behavior_or_real_second_application_consumer": true,
    "migration_scaffolding_is_not_permanent_platform_api": true,
    "historical_versions_may_remain_for_reproducibility_but_not_current_authority": true,
    "shared_core_ownership_is_conceptual_not_file_exclusivity": true,
    "legacy_mechanics_host_does_not_regain_application_authority": true
  },
  "shared_core": {
    "projection_and_uncertainty": [
      "script/build_fsffl_player_projections.py",
      "script/build_fsffl_weekly_projections.py"
    ],
    "simulation": [
      "script/build_fsffl_season_simulator.py",
      "script/run_fsffl_season_simulator_preproduction.py"
    ],
    "lineup_optimization": [
      "script/lineup_optimizer.py"
    ],
    "behavioral_intelligence": [
      "script/behavioral_intelligence.py",
      "script/behavioral_intelligence_v3.py",
      "script/behavioral_intelligence_v3_production.py"
    ],
    "historical_fact_reconstruction": [
      "script/fsffl_historical_state_provider.py"
    ],
    "roster_interaction_primitive": [
      "script/roster_interaction.py"
    ],
    "league_rules": [
      "script/league_rules.py"
    ],
    "valuation_and_future_pick_economics": [
      "script/build_fsffl_gm_engine.py"
    ],
    "team_state_evaluation": [
      "script/gm_state_weighting.py"
    ],
    "roster_resolution": [
      "script/roster_aware_trade.py"
    ]
  },
  "applications": {
    "trade_decision": {
      "entrypoint": "script/trade_engine.py",
      "internal_reasoning": [
        "script/trade_option_governance.py",
        "script/trade_candidate_pools.py",
        "script/trade_candidate_selector.py",
        "script/trade_state_policy.py",
        "script/trade_bilateral_gate.py",
        "script/trade_negotiation_family.py",
        "script/trade_multi_asset_packages.py",
        "script/negotiation_ranking.py",
        "script/roster_interaction_overlay.py",
        "script/roster_resolution_governance.py",
        "script/trade_decision/behavior_integration.py",
        "script/trade_decision/historical_behavior_policy.py"
      ],
      "migration_scaffolding": [
        "script/trade_state_selector_composition.py",
        "script/trade_multi_asset_composition.py",
        "script/trade_bilateral_composition.py"
      ],
      "legacy_mechanics_provider": "script/run_trade_market_sweep_v20.py",
      "legacy_provider_current_decision_authority": false,
      "legacy_provider_policy": "Retained mechanics only; current Trade Decision application owns final policy and recommendation authority.",
      "decision_lab_simulator_alignment": {
        "status": "aligned_current_vectorized_simulator",
        "decision_lab": "script/run_roster_decision_lab.py",
        "canonical_simulator_application": "script/run_fsffl_season_simulator.py",
        "canonical_current_engine": "script/run_fsffl_season_simulator_preproduction.py",
        "prepared_lineup_override_supported": true,
        "paired_hypothetical_runs_use_canonical_scoring_mechanics": true,
        "final_trade_confirmation_simulations": 50000,
        "broad_candidate_search_may_use_low_cost_screening": true,
        "migration_required": false
      }
    },
    "gm3": {
      "entrypoint": "script/run_fsffl_gm30_counterfactual_governed.py",
      "internal_reasoning": [
        "script/gm3/application.py",
        "script/build_fsffl_gm30.py",
        "script/run_fsffl_gm30_counterfactual.py",
        "script/gm30_nonprojection_governance.py",
        "script/package_curve_robustness.py",
        "script/nonprojection_high_priority_overrides.py"
      ],
      "application_boundary": "script/gm3/application.py",
      "legacy_mechanics_provider": "script/build_fsffl_gm_engine.py",
      "legacy_provider_current_application_authority": false,
      "application_areas": {
        "team_improvement": {
          "entrypoint": "script/gm3/team_improvement.py",
          "role": "cross-channel roster improvement reasoning",
          "current_implementation": "FSFFL-GM-Team-Improvement-Lab-1.6"
        },
        "portfolio_asset_management": {
          "role": "franchise/asset management views and recommendations",
          "current_sources": [
            "GM3 franchise outputs",
            "Breakout / Sleeper Intelligence",
            "Draft Intelligence"
          ]
        }
      }
    },
    "draft_intelligence": {
      "entrypoint": "script/draft_intelligence/application.py",
      "internal_reasoning": [
        "script/build_gm30_prospect_inputs.py",
        "script/build_gm30_prospect_features.py",
        "script/build_gm30_prospect_engine.py"
      ],
      "gm3_consumes_output": true,
      "gm3_owns_model": false
    },
    "breakout_sleeper_intelligence": {
      "entrypoint": "script/breakout_intelligence/application.py",
      "internal_reasoning": [
        "script/build_gm30_emerging_value.py"
      ],
      "gm3_consumes_output": true,
      "gm3_owns_model": false,
      "rookies_owned_by": "Draft Intelligence"
    },
    "what_if_alternate_history": {
      "application_family": "Counterfactual",
      "modes": {
        "forward_what_if": {
          "current_implementation": "script/run_fsffl_gm30_counterfactual.py",
          "current_owner": "GM3 application integration",
          "future_boundary": "Counterfactual application family"
        },
        "historical_alternate_history": {
          "shared_foundation": "script/fsffl_historical_state_provider.py",
          "current_main_status": "shared historical reconstruction present; full Alternate History application is not yet current production on main",
          "historical_trade_consumer": "script/run_historical_trade_analysis.py"
        }
      },
      "shared_primitives": [
        "historical state reconstruction",
        "state cloning and transaction application",
        "roster legality",
        "simulation",
        "branch/state transition mechanics"
      ],
      "entrypoint": "script/counterfactual/application.py",
      "application_boundary": "script/counterfactual/application.py",
      "full_alternate_history_production_on_main": false
    },
    "simulator": {
      "entrypoint": "script/run_fsffl_season_simulator.py",
      "consumes_shared_core": [
        "projection_and_uncertainty",
        "simulation",
        "league_rules"
      ],
      "owns": "season forecast orchestration and simulator outputs",
      "shared_simulation_engine_remains_core": true,
      "current_engine": "script/run_fsffl_season_simulator_preproduction.py",
      "current_engine_role": "implementation behind stable application facade",
      "historical_or_experimental_runners_may_remain": true
    },
    "opportunity_engine": {
      "entrypoint": "script/opportunity_engine/application.py",
      "application_boundary": "script/opportunity_engine/application.py",
      "role": "application-layer search and orchestration for proactive franchise opportunities",
      "phase": "v1 proactive discovery, specialist context, governed specialized views, two-step portfolio optimization, and Trade Decision routing",
      "owns": [
        "opportunity search orchestration",
        "cross-channel opportunity-board composition",
        "specialized opportunity views from governed source signals",
        "portfolio search orchestration using GM3 Team Improvement evaluation",
        "provenance and search-coverage reporting"
      ],
      "does_not_own": [
        "player projections",
        "player or pick valuation",
        "competitive simulation",
        "trade recommendation policy",
        "behavioral acceptance probability",
        "GM3 franchise objective utility"
      ],
      "authoritative_consumers": {
        "team_improvement": "script/gm3/team_improvement.py",
        "trade_execution_review": "script/trade_engine.py",
        "simulator": "script/run_fsffl_season_simulator.py",
        "portfolio_evaluation": "script/gm3/team_improvement.py",
        "draft_intelligence": "script/draft_intelligence/application.py",
        "breakout_sleeper_intelligence": "script/breakout_intelligence/application.py"
      },
      "trade_candidate_policy": "GM3 Team Improvement discovers/ranks franchise-improvement trade candidates; Opportunity Engine routes leading generated proposals through the stable Trade Decision facade before execution advice.",
      "waiver_policy": "GM3 Team Improvement remains authoritative for waiver/add-drop opportunity evaluation.",
      "shared_core_policy": "No new Shared Core primitive is promoted in Opportunity Engine v1; reusable primitives are added only when domain-generic or consumed by a second application.",
      "rescoring_authority": false,
      "duplicate_valuation_authority": false,
      "search_heuristics_may_be_final_decision_authority": false,
      "portfolio_policy": "Opportunity Engine may enumerate structurally compatible action bundles, but GM3 Team Improvement owns bundle simulation and shared decision utility; search depth is a computational budget, not decision authority.",
      "trade_review_policy": "Default production routing confirms the leading generated trade through Trade Decision at its canonical high-precision simulation depth; review depth is a computational budget, not a valuation weight.",
      "specialist_context_policy": "Draft Intelligence and Breakout / Sleeper Intelligence may explain or surface existing candidates but may not alter Opportunity Engine ranking outside their owning authoritative models."
    }
  },
  "analytics_derived_products": {
    "record_book": {
      "builder": "script/build_competition_record_book.py",
      "audit_builder": "script/build_record_book_audit.py",
      "source_role": "deterministic historical aggregation",
      "predictive_model": false
    },
    "competitive_landscape": {
      "source": "Simulator application outputs",
      "renderer": "script/render_league_power_report.py",
      "independent_power_model": false
    },
    "historical_trade_analysis": {
      "entrypoint": "script/run_historical_trade_analysis.py",
      "sources": [
        "shared historical facts",
        "GM3/Decision Lab evaluation"
      ],
      "independent_valuation_model": false
    },
    "contender_analysis": {
      "source": "Simulator application outputs",
      "renderer": "script/render_league_power_report.py",
      "independent_model": false
    }
  },
  "reports_publications": {
    "standardized_report_pack": {
      "workflow": ".github/workflows/build-standardized-reports.yml",
      "presentation_only": true
    },
    "record_book": {
      "renderer": "script/render_record_book_report.py",
      "consumes": "analytics_derived_products.record_book"
    },
    "competitive_landscape": {
      "renderer": "script/render_league_power_report.py",
      "consumes": "Simulator outputs"
    },
    "draft_recap": {
      "renderer": "script/render_draft_recap_report.py",
      "consumes": [
        "Draft Intelligence",
        "GM3/team state"
      ]
    },
    "team_season_outlook": {
      "renderer": "script/render_simulator_report.py",
      "consumes": "Simulator outputs"
    },
    "gm_franchise_report": {
      "renderer": "script/render_gm_franchise_report.py",
      "consumes": "GM3 outputs"
    },
    "preseason_report": {
      "status": "publication/orchestration product",
      "consumes": [
        "Simulator",
        "GM3",
        "Draft Intelligence",
        "Breakout/Sleeper Intelligence",
        "Shared Core valuation/team state"
      ],
      "owns_independent_model": false
    },
    "reporting_module": {
      "stable_facade": "script/reporting/__init__.py",
      "owns": [
        "user-facing terminology",
        "contextual narrative composition",
        "number context",
        "evidence-triggered visual selection",
        "shared report styling"
      ],
      "consumes": [
        "Shared Core outputs",
        "Application outputs",
        "Analytics / Derived Product outputs"
      ],
      "decision_authority": false,
      "rescoring_authority": false,
      "workflow_specific_renderers_remain_thin_consumers": true
    },
    "opportunity_engine_report": {
      "renderer": "script/render_opportunity_engine_report.py",
      "consumes": "Opportunity Engine output",
      "presentation_only": true,
      "decision_authority": false,
      "rescoring_authority": false
    }
  },
  "competitive_state_governance": {
    "owner": "Shared FSFFL Core / GM state weighting",
    "runtime": "script/gm_state_weighting.py",
    "competitive_strength_source": "canonical Simulator league-relative outcome ordering",
    "roster_strength_source": "GM3 optimized current-season roster percentile",
    "dynasty_strength_source": "GM3 optimized dynasty roster percentile",
    "categorical_labels": "provisional expert-prior metadata only",
    "objective_weights": "continuous interpolation; no step change at categorical label boundaries",
    "simulator_double_counting_prevented": true,
    "legacy_stepwise_threshold_function_has_current_authority": false
  }
}
